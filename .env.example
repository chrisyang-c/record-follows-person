# ---- Model provider --------------------------------------------------------
# MODEL_PROVIDER=openai → settings.get_model() = ChatOpenAI(model=MODEL_PINNED, temperature=0)
#   gpt-5.x 會再加 reasoning_effort="none"（chat completions 的 function tools 需要；temperature=0 也只在此時被接受）
# 成本估算（USD / 1M tokens，只用於 trace 與 ACCEPTANCE）：PRICE_INPUT_PER_M=0.20 PRICE_CACHED_INPUT_PER_M=0.02 PRICE_CACHE_WRITE_PER_M=0.25 PRICE_OUTPUT_PER_M=1.20
# MODEL_PROVIDER=anthropic → ChatAnthropic(model=MODEL_PINNED, temperature=0)
# MODEL_PROVIDER=mock → deterministic lexicon/templates (tests, CI). A provider whose key is
# empty degrades to mock with a warning so the demo still runs.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Exact pinned model id used by every deep agent and graph node (CLAUDE.md §5).
MODEL_PINNED=gpt-5.6-luna
# intake（extract／next_question）的 reasoning_effort：none＝chat completions；low／medium／high＝改走 Responses API
INTAKE_REASONING_EFFORT=low

# ---- Database (LangGraph PostgresSaver checkpointer + thread registry) -----
# docker compose:  postgresql://rfp:rfp@localhost:5432/record_follows_person
# brew (make db-local): postgresql://localhost:5432/record_follows_person
DATABASE_URL=postgresql://rfp:rfp@localhost:5432/record_follows_person

# ---- LINE (family notification). Empty = display only, never sent. -------
LINE_CHANNEL_TOKEN=
LINE_FAMILY_TO=

# ---- Records root (one directory per resident; git-ignored) ---------------
RECORDS_ROOT=../../records

# ---- Timeouts (seconds) ---------------------------------------------------
NURSE_REVIEW_TIMEOUT_S=600   # demo: 60 to see escalation quickly
WORKER_SCAN_INTERVAL_S=30

# ---- Web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
