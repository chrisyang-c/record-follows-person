# ---- LLM ------------------------------------------------------------------
# LLM_MODE=anthropic uses Claude via langchain-anthropic; LLM_MODE=mock uses the
# deterministic keyword extractor (no network, used by tests / eval / CI).
LLM_MODE=mock
ANTHROPIC_API_KEY=
# Pinned exact model id used by the personal deep agent and all LLM nodes.
MODEL_PINNED=claude-sonnet-5

# ---- Database (LangGraph PostgresSaver checkpointer + thread registry) -----
# docker compose:  postgresql://rfp:rfp@localhost:5432/record_follows_person
# brew (make db-local): postgresql://localhost:5432/record_follows_person
DATABASE_URL=postgresql://rfp:rfp@localhost:5432/record_follows_person

# ---- LINE (family notification). Empty = display only, never sent. -------
LINE_CHANNEL_TOKEN=
LINE_FAMILY_TO=

# ---- Records root (one directory per resident; git-ignored) ---------------
RECORDS_ROOT=../../records

# ---- Timeouts (seconds) ---------------------------------------------------
NURSE_REVIEW_TIMEOUT_S=600
WORKER_SCAN_INTERVAL_S=30

# ---- Web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
